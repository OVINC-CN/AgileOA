{
  "name": "@agile-workspace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:add": "pnpm dlx shadcn@4.23.0 add",
    "check:static": "pnpm format:check && pnpm lint && pnpm build",
    "check": "pnpm check:static && pnpm test"
  },
  "dependencies": {
    "@file-viewer/core": "3.3.6",
    "@file-viewer/renderer-image": "3.3.6",
    "@file-viewer/renderer-pdf": "3.3.6",
    "@file-viewer/renderer-presentation": "3.3.6",
    "@file-viewer/renderer-spreadsheet": "3.3.6",
    "@file-viewer/renderer-word": "3.3.6",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-table": "^8.21.3",
    "aegis-web-sdk": "1.41.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-js-sdk-v5": "1.10.1",
    "diff": "9.0.0",
    "exceljs": "4.4.0",
    "lossless-json": "4.3.3",
    "lucide-react": "^1.66.0",
    "pinyin-pro": "3.29.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "8.5.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@file-viewer/assets-ppt": "3.3.6",
    "@file-viewer/assets-standard": "3.3.6",
    "@file-viewer/vite-plugin": "3.3.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "^5.105.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
